{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "**",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/api.php", "dest": "/api/api.php" },
    { "src": "/status.php", "dest": "/api/status.php" },
    { "src": "/read.php", "dest": "/api/read.php" },
    { "src": "/index.php", "dest": "/api/index.php" },
    { "src": "/(backend|server|public)(/.*)?", "status": 404 },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}